    "/v1/ledger": {
      "get": {
        "tags": [
          "Finance"
        ],
        "summary": "Incremental, buyer-scoped ledger records for ERP reconciliation",
        "description": "Allocation-field filters are part of the spec; their query syntax is not yet fixed in arc/0.7. See spec §10.3.",
        "operationId": "get_v1_ledger",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "description": "Filter by ledger state.",
            "schema": {
              "enum": [
                "committed",
                "settled",
                "held",
                "refunded",
                "auto_settled"
              ]
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Start of period (event time, inclusive).",
            "schema": {
              "$ref": "./schemas/0.7/common.json#/$defs/timestamp"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "End of period (event time, exclusive).",
            "schema": {
              "$ref": "./schemas/0.7/common.json#/$defs/timestamp"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor from the previous page, for incremental reads.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ledger records ordered by event time.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "./schemas/0.7/ledger_record.json"
                  }
                }
              }
            }
          },
          "4XX": {
            "description": "ARC error (spec §15)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
