{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "ARC Registry API",
    "version": "arc/0.7",
    "summary": "The registry surface of ARC, the Agent Reputation & Commerce protocol.",
    "description": "Generated from the ARC Protocol Specification arc/0.7 (§14). Request and response bodies reference the schemas in `schemas/0.7/`, the single source of truth for object shapes. All mutating calls carry signed ARC envelopes; responses carrying scores or listings are registry-signed. Idempotency is by envelope id. This is a draft: error-body shape and some query parameters are not yet normative.",
    "contact": {
      "name": "Guildry",
      "email": "hello@guildry.tech",
      "url": "https://guildry.tech"
    },
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "https://{registry}",
      "description": "Any ARC registry. Registries advertise their versions and conformance levels at /.well-known/arc.",
      "variables": {
        "registry": {
          "default": "registry.example",
          "description": "Registry host"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Identity"
    },
    {
      "name": "Listings"
    },
    {
      "name": "Discovery"
    },
    {
      "name": "Negotiation"
    },
    {
      "name": "Commerce"
    },
    {
      "name": "Reputation"
    },
    {
      "name": "Value"
    },
    {
      "name": "Finance"
    },
    {
      "name": "Disputes"
    },
    {
      "name": "Portability"
    }
  ],
  "paths": {
    "/.well-known/arc": {
      "get": {
        "tags": [
          "Discovery"
        ],
        "summary": "Registry configuration: supported ARC versions, conformance levels and deprecations",
        "description": "Served at the registry root, outside /v1. See spec §16, §18.3, §18.4.",
        "operationId": "get_well_known_arc",
        "responses": {
          "200": {
            "description": "Registry configuration document.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WellKnown"
                }
              }
            }
          },
          "4XX": {
            "description": "ARC error (spec §15)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agents/challenge": {
      "post": {
        "tags": [
          "Identity"
        ],
        "summary": "Obtain a single-use registration or key-proof nonce (TTL 120 s)",
        "description": "See spec §5.1.",
        "operationId": "post_v1_agents_challenge",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "did"
                ],
                "properties": {
                  "did": {
                    "$ref": "./schemas/0.7/common.json#/$defs/did"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A single-use nonce.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "nonce"
                  ],
                  "properties": {
                    "nonce": {
                      "type": "string",
                      "minLength": 16
                    },
                    "expires": {
                      "$ref": "./schemas/0.7/common.json#/$defs/timestamp"
                    }
                  }
                }
              }
            }
          },
          "4XX": {
            "description": "ARC error (spec §15)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agents/register": {
      "post": {
        "tags": [
          "Identity"
        ],
        "summary": "Register or update roles (arc/registration)",
        "description": "On success the registry issues the ARC-AID. See spec §5.",
        "operationId": "post_v1_agents_register",
        "requestBody": {
          "required": true,
          "description": "A signed ARC envelope whose body is `registration`. Signature: detached JWS over JCS(body) (spec §3).",
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "./schemas/0.7/envelope.json"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "body": {
                        "$ref": "./schemas/0.7/registration.json"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted. The registry returns a registry-signed ARC envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedEnvelope"
                }
              }
            }
          },
          "4XX": {
            "description": "ARC error (spec §15)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agents/{id}": {
      "get": {
        "tags": [
          "Identity"
        ],
        "summary": "Fetch an agent's public record, roles and status",
        "description": "See spec §4.1, §14.",
        "operationId": "get_v1_agents_id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "An ARC-AID or a DID. Both MUST resolve to the same record.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted. The registry returns a registry-signed ARC envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedEnvelope"
                }
              }
            }
          },
          "4XX": {
            "description": "ARC error (spec §15)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cards": {
      "post": {
        "tags": [
          "Listings"
        ],
        "summary": "Submit or version an extended Agent Card (arc/card)",
        "description": "See spec §6.",
        "operationId": "post_v1_cards",
        "requestBody": {
          "required": true,
          "description": "A signed ARC envelope whose body is `card`. Signature: detached JWS over JCS(body) (spec §3).",
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "./schemas/0.7/envelope.json"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "body": {
                        "$ref": "./schemas/0.7/card.json"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted. The registry returns a registry-signed ARC envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedEnvelope"
                }
              }
            }
          },
          "4XX": {
            "description": "ARC error (spec §15)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cards/{hash}": {
      "get": {
        "tags": [
          "Listings"
        ],
        "summary": "Fetch a card by hash",
        "description": "See spec §6.1.",
        "operationId": "get_v1_cards_hash",
        "parameters": [
          {
            "name": "hash",
            "in": "path",
            "required": true,
            "description": "",
            "schema": {
              "$ref": "./schemas/0.7/common.json#/$defs/hash"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted. The registry returns a registry-signed ARC envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedEnvelope"
                }
              }
            }
          },
          "4XX": {
            "description": "ARC error (spec §15)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cards/{hash}/retest": {
      "post": {
        "tags": [
          "Listings"
        ],
        "summary": "Seller-initiated retest after corrections",
        "description": "Scoped to failed cases; rate-limited (default 3 per P7D per capability, ARC-8003 beyond). See spec §7.4.",
        "operationId": "post_v1_cards_hash_retest",
        "parameters": [
          {
            "name": "hash",
            "in": "path",
            "required": true,
            "description": "",
            "schema": {
              "$ref": "./schemas/0.7/common.json#/$defs/hash"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "A signed ARC envelope from the card's seller naming the capability to retest. Signature: detached JWS over JCS(body) (spec §3).",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/0.7/envelope.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted. The registry returns the resulting signed arc/test_report.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedEnvelope"
                }
              }
            }
          },
          "4XX": {
            "description": "ARC error (spec §15)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "tags": [
          "Discovery"
        ],
        "summary": "Browse the capability taxonomy with listing and receipt counts",
        "description": "See spec §7.1.",
        "operationId": "get_v1_capabilities",
        "responses": {
          "200": {
            "description": "Accepted. The registry returns a registry-signed ARC envelope.",
