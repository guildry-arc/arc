  "components": {
    "schemas": {
      "SignedEnvelope": {
        "$ref": "./schemas/0.7/envelope.json"
      },
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "description": "Not yet normative in arc/0.7: the spec defines the codes but not the error body.",
        "properties": {
          "code": {
            "enum": [
              "ARC-1001",
              "ARC-1002",
              "ARC-1003",
              "ARC-1004",
              "ARC-1005",
              "ARC-2001",
              "ARC-2002",
              "ARC-2003",
              "ARC-2004",
              "ARC-2005",
              "ARC-3001",
              "ARC-3002",
              "ARC-4001",
              "ARC-4002",
              "ARC-4003",
              "ARC-4004",
              "ARC-5001",
              "ARC-5002",
              "ARC-6001",
              "ARC-6002",
              "ARC-7001",
              "ARC-7002",
              "ARC-7003",
              "ARC-8001",
              "ARC-8002",
              "ARC-8003"
            ],
            "description": "- `ARC-1001` Signature invalid or key not resolvable from DID.\n- `ARC-1002` Unknown or inactive DID / role not held.\n- `ARC-1003` Nonce missing, expired, or reused.\n- `ARC-1004` Unknown value in an open enum with no defined fallback (e.g. pricing model); the offer or object is rejected cleanly.\n- `ARC-1005` Protocol version unsupported or past its sunset; the response lists versions_supported from /.well-known/arc.\n- `ARC-2001` Trust policy matched no candidates (includes nearest-miss hints).\n- `ARC-2002` Snapshot expired; re-query before offering.\n- `ARC-2003` Buyer does not satisfy the seller's buyer_requirements.\n- `ARC-2004` io_schema incompatible with the buyer's example input or expected output.\n- `ARC-2005` Capability not probe-verified and require_probe_verified is set.\n- `ARC-3001` Escrow lock exceeds registered spend policy.\n- `ARC-3002` Payment mandate invalid or rail unavailable.\n- `ARC-4001` Receipt fields inconsistent with offer or engagement.\n- `ARC-4002` Attestation window expired.\n- `ARC-4003` Duplicate attestation for receipt and dimension.\n- `ARC-4004` Rater identity does not match receipt buyer.\n- `ARC-5001` Dispute ineligible or window expired.\n- `ARC-5002` No conformant verifier available; dispute queued.\n- `ARC-6001` Negotiation message cap reached; chain abandoned.\n- `ARC-6002` Quote expired or non-monotonic counter rejected.\n- `ARC-7001` Value model unknown, unsigned, or inconsistent units.\n- `ARC-7002` Outcome evidence missing or insufficient for the claimed value.\n- `ARC-7003` Reported value below the computed value floor of a value_share engagement.\n- `ARC-8001` Trial ineligible: already availed for this capability, or eligibility requirements unmet.\n- `ARC-8002` Trial cap reached; the trial engagement has expired. Convert with a paid offer.\n- `ARC-8003` Retest limit or correction window exceeded for this capability."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "WellKnown": {
        "type": "object",
        "required": [
          "versions_supported",
          "conformance"
        ],
        "description": "Registry configuration document (spec §18.3).",
        "properties": {
          "versions_supported": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "./schemas/0.7/common.json#/$defs/version"
            }
          },
          "conformance": {
            "type": "array",
            "items": {
              "enum": [
                "ARC-Core",
                "ARC-Commerce",
                "ARC-Reputation",
                "ARC-Port"
              ]
            }
          },
          "deprecations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "feature",
                "deprecated",
                "sunset"
              ],
              "properties": {
                "feature": {
                  "type": "string"
                },
                "deprecated": {
                  "type": "string",
                  "format": "date"
                },
                "sunset": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        }
      }
    }
  }
}
