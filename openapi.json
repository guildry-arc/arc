      "get": {
        "tags": [
          "Discovery"
        ],
        "summary": "Cards listed under a taxonomy node",
        "description": "See spec §7.1.",
        "operationId": "get_v1_capabilities_node",
        "parameters": [
          {
            "name": "node",
            "in": "path",
            "required": true,
            "description": "e.g. arc.document.extraction.invoice",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted. The registry returns a registry-signed ARC envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedEnvelope"
                }
              }
            }
          },
          "4XX": {
            "description": "ARC error (spec §15)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/discovery/query": {
      "post": {
        "tags": [
          "Discovery"
        ],
        "summary": "Trust-policy and/or intent query; returns a signed arc/snapshot",
        "description": "See spec §7.2, §7.4.",
        "operationId": "post_v1_discovery_query",
        "requestBody": {
          "required": true,
          "description": "A signed ARC envelope whose body is `policy`. Signature: detached JWS over JCS(body) (spec §3).",
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "./schemas/0.7/envelope.json"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "body": {
                        "$ref": "./schemas/0.7/policy.json"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A registry-signed envelope whose body is an arc/snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./schemas/0.7/envelope.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "body": {
                          "$ref": "./schemas/0.7/snapshot.json"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "4XX": {
            "description": "ARC error (spec §15)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/rfqs": {
      "post": {
        "tags": [
          "Negotiation"
        ],
        "summary": "Open an RFQ; the registry fans out to eligible sellers only (max 8)",
        "description": "See spec §8.1.",
        "operationId": "post_v1_rfqs",
        "requestBody": {
          "required": true,
          "description": "A signed ARC envelope whose body is `rfq`. Signature: detached JWS over JCS(body) (spec §3).",
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "./schemas/0.7/envelope.json"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "body": {
                        "$ref": "./schemas/0.7/rfq.json"
                      }
                    }
