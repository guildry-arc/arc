                "schema": {
                  "$ref": "#/components/schemas/SignedEnvelope"
                }
              }
            }
          },
          "4XX": {
            "description": "ARC error (spec §15)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/rfqs/{id}/quotes": {
      "get": {
        "tags": [
          "Negotiation"
        ],
        "summary": "Collected quotes for an RFQ (requester only)",
        "description": "See spec §8.1.",
        "operationId": "get_v1_rfqs_id_quotes",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "",
            "schema": {
              "$ref": "./schemas/0.7/common.json#/$defs/uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Signed arc/quote envelopes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "allOf": [
                      {
                        "$ref": "./schemas/0.7/envelope.json"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "body": {
                            "$ref": "./schemas/0.7/quote.json"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "4XX": {
            "description": "ARC error (spec §15)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
