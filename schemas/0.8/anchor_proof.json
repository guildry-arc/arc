{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/guildry-arc/arc/main/schemas/0.8/anchor_proof.json",
  "title": "Merkle inclusion proof (GET /v1/anchors/proof/{hash}; ARC-Port, spec §19.3)",
  "description": "Proves one envelope is covered by an on-chain root. Draft shape: spec §19.3 defines the endpoint's purpose but not its fields.",
  "type": "object",
  "required": [
    "hash",
    "root",
    "path",
    "anchor"
  ],
  "properties": {
    "hash": {
      "$ref": "common.json#/$defs/hash",
      "description": "The envelope hash being proved"
    },
    "root": {
      "$ref": "common.json#/$defs/hash"
    },
    "path": {
      "type": "array",
      "description": "Sibling hashes from leaf to root",
      "items": {
        "type": "object",
        "required": [
          "position",
          "hash"
        ],
        "properties": {
          "position": {
            "enum": [
              "left",
              "right"
            ]
          },
          "hash": {
            "$ref": "common.json#/$defs/hash"
          }
        }
      }
    },
    "anchor": {
      "type": "object",
      "required": [
        "chain",
        "contract",
        "tx",
        "anchored"
      ],
      "properties": {
        "chain": {
          "type": "string",
          "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
          "description": "CAIP-2 chain id, e.g. eip155:8453 (Base)"
        },
        "contract": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "description": "Append-only anchor contract address"
        },
        "tx": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "description": "Transaction that wrote the root"
        },
        "anchored": {
          "$ref": "common.json#/$defs/timestamp"
        }
      }
    }
  }
}
