{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/guildry-arc/arc/main/schemas/0.5/common.json",
  "title": "ARC shared definitions",
  "$defs": {
    "aid": {
      "type": "string",
      "pattern": "^arc:[a-z0-9.-]+:[A-Z0-9]{16}$"
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:.+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "duration": {
      "type": "string",
      "pattern": "^P",
      "description": "ISO 8601 duration"
    },
    "jws": {
      "type": "string",
      "minLength": 1,
      "description": "Detached JWS over JCS(body)"
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "disclosure": {
      "enum": [
        "private",
        "aggregate",
        "public"
      ]
    },
    "rail": {
      "enum": [
        "ap2",
        "x402"
      ]
    },
    "engagement_type": {
      "enum": [
        "spot",
        "term",
        "standing"
      ]
    },
    "allocation": {
      "type": "object",
      "description": "Buyer cost-allocation tags; set on offers, inherited immutably by receipts.",
      "properties": {
        "cost_center": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "workflow_id": {
          "type": "string"
        },
        "customer_ref": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "pricing": {
      "type": "object",
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "enum": [
            "per_task",
            "per_unit",
            "tiered",
            "retainer",
            "value_share"
          ]
        },
        "unit": {
          "type": "string",
          "description": "e.g. task, 1k_tokens, page, minute, item"
        },
        "price": {
          "$ref": "common.json#/$defs/money"
        },
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "min_volume",
              "unit_price"
            ],
            "properties": {
              "min_volume": {
                "type": "integer",
                "minimum": 1
              },
              "unit_price": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?$"
              }
            }
          }
        },
        "minimum": {
          "$ref": "common.json#/$defs/money"
        },
        "negotiable": {
          "type": "boolean",
          "default": false
        },
        "value_share": {
          "type": "object",
          "required": [
            "share_pct"
          ],
          "properties": {
            "base_fee": {
              "$ref": "common.json#/$defs/money"
            },
            "share_pct": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "model": {
                "const": "value_share"
              }
            }
          },
          "then": {
            "required": [
              "value_share"
            ]
          }
        }
      ]
    },
    "slo": {
      "type": "object",
      "properties": {
        "max_latency_ms": {
          "type": "integer",
          "minimum": 1
        },
        "min_accuracy": {
          "$ref": "common.json#/$defs/score"
        },
        "verification": {
          "enum": [
            "buyer_outcome_attestation",
            "verifier",
            "computed"
          ]
        }
      }
    },
    "rubric": {
      "type": "object",
      "required": [
        "criteria"
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "check",
              "weight"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "check": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "scale": {
          "type": "string",
          "default": "0.0-1.0 per criterion"
        }
      }
    },
    "payout_table": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "if",
          "pay"
        ],
        "properties": {
          "if": {
            "enum": [
              "slo_met",
              "latency_miss",
              "accuracy_miss"
            ]
          },
          "pay": {
            "type": "string",
            "pattern": "^[0-9]{1,3}%$"
          },
          "dispute_eligible": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
