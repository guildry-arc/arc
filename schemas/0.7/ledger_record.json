{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/guildry-arc/arc/main/schemas/0.7/ledger_record.json",
  "title": "Ledger export record (GET /v1/ledger; finance observability, arc/0.5)",
  "type": "object",
  "required": [
    "entry_id",
    "receipt_hash",
    "state",
    "amount",
    "event_time"
  ],
  "properties": {
    "entry_id": {
      "$ref": "common.json#/$defs/uuid"
    },
    "receipt_hash": {
      "$ref": "common.json#/$defs/hash"
    },
    "state": {
      "enum": [
        "committed",
        "settled",
        "held",
        "refunded",
        "auto_settled"
      ]
    },
    "amount": {
      "$ref": "common.json#/$defs/money"
    },
    "payout_tier": {
      "type": "string"
    },
    "seller_aid": {
      "$ref": "common.json#/$defs/aid"
    },
    "capability": {
      "type": "string"
    },
    "taxonomy_node": {
      "type": "string"
    },
    "engagement_ref": {
      "$ref": "common.json#/$defs/hash"
    },
    "allocation": {
      "$ref": "common.json#/$defs/allocation"
    },
    "event_time": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "quote_ref": {
      "$ref": "common.json#/$defs/uuid"
    },
    "outcome_refs": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/uuid"
      }
    },
    "trial": {
      "type": "boolean",
      "default": false,
      "description": "Trial usage: itemized shadow cost, excluded from paid-spend totals (spec §10.3)."
    }
  }
}
