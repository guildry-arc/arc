{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/guildry-arc/arc/main/schemas/0.7/registration.json",
  "title": "arc/registration body",
  "type": "object",
  "required": [
    "nonce",
    "roles"
  ],
  "properties": {
    "nonce": {
      "type": "string",
      "minLength": 16
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "buyer",
          "seller",
          "verifier"
        ]
      }
    },
    "buyer": {
      "type": "object",
      "required": [
        "payment_mandate",
        "spend_policy"
      ],
      "properties": {
        "payment_mandate": {
          "type": "object",
          "required": [
            "rail",
            "mandate_ref",
            "currency"
          ],
          "properties": {
            "rail": {
              "$ref": "common.json#/$defs/rail"
            },
            "mandate_ref": {
              "type": "string"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        },
        "spend_policy": {
          "type": "object",
          "required": [
            "max_per_task",
            "max_per_day"
          ],
          "properties": {
            "max_per_task": {
              "$ref": "common.json#/$defs/money"
            },
            "max_per_day": {
              "$ref": "common.json#/$defs/money"
            },
            "max_open_escrow": {
              "$ref": "common.json#/$defs/money"
            },
            "circuit_breaker": {
              "type": "object",
              "properties": {
                "failed_tasks_per_hour": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "callback_url": {
          "$ref": "common.json#/$defs/url"
        }
      }
    },
    "seller": {
      "type": "object",
      "required": [
        "card_ref",
        "mcp_endpoint",
        "payout_address"
      ],
      "properties": {
        "card_ref": {
          "$ref": "common.json#/$defs/hash"
        },
        "mcp_endpoint": {
          "$ref": "common.json#/$defs/url"
        },
        "payout_address": {
          "type": "object",
          "required": [
            "rail",
            "ref"
          ],
          "properties": {
            "rail": {
              "$ref": "common.json#/$defs/rail"
            },
            "ref": {
              "type": "string"
            }
          }
        },
        "engagement_types": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/engagement_type"
          }
        },
        "callback_url": {
          "$ref": "common.json#/$defs/url"
        }
      }
    },
    "arc_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.json#/$defs/version"
      },
      "description": "Protocol versions this agent speaks. The lowest is its downgrade floor (spec §18.3, §17)."
    }
  }
}
